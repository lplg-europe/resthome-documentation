msgid "Last MNA = malnourished?"
msgstr "Dernier MNA = dénutri ?"

#: ../../content/repas/suivi-nutritionnel.md:84
msgid "Yes"
msgstr "Oui"

#: ../../content/repas/suivi-nutritionnel.md:84
msgid "Undernutrition"
msgstr "Dénutrition"

#: ../../content/repas/suivi-nutritionnel.md:84
msgid "No"
msgstr "Non"

#: ../../content/repas/suivi-nutritionnel.md:84
msgid "Screening signal active?"
msgstr "Signal de dépistage actif ?"

#: ../../content/repas/suivi-nutritionnel.md:84
msgid "Re-screen MNA"
msgstr "Refaire le dépistage MNA"

#: ../../content/repas/suivi-nutritionnel.md:84
msgid "Last MNA = at risk?"
msgstr "Dernier MNA = à risque ?"

#: ../../content/repas/suivi-nutritionnel.md:84
msgid "To monitor"
msgstr "À surveiller"

#: ../../content/repas/suivi-nutritionnel.md:84

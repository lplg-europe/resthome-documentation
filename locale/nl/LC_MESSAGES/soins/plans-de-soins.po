#: ../../content/soins/plans-de-soins.md:44
msgid "The planned care tasks"
msgstr "De geplande zorgtaken"

#: ../../content/soins/plans-de-soins.md:44
msgid "**Missed care**"
msgstr "**Gemiste zorgen**"

#: ../../content/soins/plans-de-soins.md:44
msgid "Care nobody answered for"
msgstr "De zorg waarvoor niemand antwoordde"

#: ../../content/soins/plans-de-soins.md:44

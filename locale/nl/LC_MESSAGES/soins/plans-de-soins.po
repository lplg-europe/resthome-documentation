#: ../../content/soins/plans-de-soins.md:44
msgid "**Prescriptions**"
msgstr "**Voorschriften**"

#: ../../content/soins/plans-de-soins.md:44
msgid "The resident's prescriptions"
msgstr "De voorschriften van de bewoner"

#: ../../content/soins/plans-de-soins.md:44
msgid "**To consider** / **Evidence**"
msgstr "**Te overwegen** / **Onderbouwing**"


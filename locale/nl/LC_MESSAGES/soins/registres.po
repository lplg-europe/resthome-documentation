#: ../../content/soins/registres.md:11
msgid "The continence situation and how it changes"
msgstr "De continentiesituatie en hoe ze evolueert"

#: ../../content/soins/registres.md:11
msgid "**Wound Registry**"
msgstr "**Wondregister**"

#: ../../content/soins/registres.md:11
msgid "Wounds, their care and their healing"
msgstr "De wonden, hun verzorging en hun genezing"

#: ../../content/soins/registres.md:11

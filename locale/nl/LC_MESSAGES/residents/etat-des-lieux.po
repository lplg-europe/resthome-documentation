#: ../../content/residents/etat-des-lieux.md:41
msgid "To do"
msgstr "Te doen"

#: ../../content/residents/etat-des-lieux.md:41
msgid "Planned"
msgstr "Gepland"

#: ../../content/residents/etat-des-lieux.md:41
msgid "Done"
msgstr "Voltooid"

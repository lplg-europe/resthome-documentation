#: ../../content/facturation/facturer-un-mois.md:233
msgid "[Billing a residence](../residences-services/facturation.md) — its residents join the same monthly period with their unit and contract."
msgstr "[Een residentie factureren](../residences-services/facturation.md) — haar bewoners komen in dezelfde maandperiode met hun wooneenheid en hun contract."

#: ../../content/facturation/facturer-un-mois.md:216
msgid "Open the period"
msgstr "De periode openen"

#: ../../content/facturation/facturer-un-mois.md:216
msgid "Generate"
msgstr "Genereren"

#: ../../content/facturation/facturer-un-mois.md:216
msgid "Review"
msgstr "Nakijken"

#: ../../content/facturation/facturer-un-mois.md:216
msgid "Create Invoices"
msgstr "Facturen aanmaken"

#: ../../content/facturation/facturer-un-mois.md:216
msgid "Confirm the invoices"
msgstr "De facturen boeken"

#: ../../content/facturation/facturer-un-mois.md:216
msgid "Close Period"
msgstr "Periode sluiten"
